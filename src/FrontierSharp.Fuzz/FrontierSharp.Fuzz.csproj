    <ProjectReference Include="../FrontierSharp.SuiClient/FrontierSharp.SuiClient.csproj" />
    <ProjectReference Include="../FrontierSharp.WorldApi/FrontierSharp.WorldApi.csproj" />
  </ItemGroup>
</Project>
